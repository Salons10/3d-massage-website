VITE_WIX_API_KEY=your_wix_api_key_here

# MailerSend (email API) — https://app.mailersend.com/api-tokens
MAILERSEND_API_KEY=your_mailersend_api_key_here
CONTACT_RECIPIENT_EMAIL=your@email.com

# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin/create
# VITE_ prefix = exposed to browser (safe for site key only)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
